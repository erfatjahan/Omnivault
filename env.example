PORT=5000
# Frontend & Dashboard URLs
FRONTEND_URL=your_FRONTEND_URL
DASHBOARD_URL=your_DASHBOARD_URL

# JWT Configuration
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_IN=7
JWT_SECRET_KEY=your_secure_secret_key

# Database Connection
DATABASE_URL=postgresql://username:password@localhost:5432/omnivault_db

# Email Configuration (SMTP)
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary Storage Configuration
CLOUDINARY_CLIENT_NAME=your_cloudinary_cloud_name
CLOUDINARY_CLIENT_API=your_cloudinary_api_key
CLOUDINARY_CLIENT_SECRET=your_cloudinary_secret_key

# SSLCommerz Payment Gateway Configuration
SSLCOMMERZ_STORE_ID=your_store_id_ekhane_din
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
